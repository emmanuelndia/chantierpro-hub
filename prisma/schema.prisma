generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERVISOR
  RESOURCE
  EXTERNAL_RESOURCE
  COORDINATOR
  GENERAL_SUPERVISOR
  BE_MANAGER
  BE_RESOURCE
  NEGOTIATION_MANAGER
  NEGOTIATION_RESOURCE
  FLEET_MANAGER
  DRIVER
  PROJECT_MANAGER
  DIRECTION
  HR
  ADMIN
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum SiteGeofenceType {
  RADIUS
  POLYGON
}

enum SiteType {
  WORKSITE
  INTERVENTION_ZONE
  WAREHOUSE
  MATERIAL_PICKUP
  OFFICE
  CLIENT_SITE
  OTHER
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum TeamRole {
  TEAM_LEAD
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
}

enum ClockInType {
  ARRIVAL
  DEPARTURE
  INTERMEDIATE
  PAUSE_START
  PAUSE_END
}

enum ClockInStatus {
  VALID
  REJECTED
  ANOMALY
}

enum PhotoCategory {
  PROGRESS
  INCIDENT
  OTHER
}

enum PhotoTag {
  TASK_START
  TASK_END
  BLOCKAGE
  WORK_PROOF
  INCIDENT
}

enum RhExportFormat {
  CSV
  XLSX
  PDF
}

enum ReportStatus {
  RECU
  EN_REVUE
  VALIDE
  ENVOYE
}

enum ReportValidationStatus {
  SUBMITTED
  VALIDATED_FOR_CLIENT
}

enum PlanningAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanningWorkLocationType {
  ON_SITE
  OFFICE
  FREE_MISSION
}

enum OfficeClockInLocation {
  OFFICE
}

enum UserNotificationAudience {
  ALL
  ROLE
  USERS
}

enum FreeMissionStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NegotiationAssignmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NegotiationSessionStatus {
  OPEN
  CLOSED
  ANOMALY
}

enum NegotiationVisitStatus {
  OK
  EN_COURS
  REFUS
  ABSENT
  A_REVISITER
  LITIGE_TRAVAUX
  AUTRE
}

enum GeneralSupervisorSiteScopeStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  email              String?             @unique
  matricule          String?             @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role
  contact            String
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  managedProjects    Project[]           @relation("ProjectManager")
  createdProjects    Project[]           @relation("ProjectCreator")
  managedSites       Site[]              @relation("SiteManager")
  createdSites       Site[]              @relation("SiteCreator")
  ledTeams           Team[]              @relation("TeamLead")
  createdTeams       Team[]              @relation("TeamCreator")
  teamMemberships    TeamMember[]        @relation("TeamMemberUser")
  createdMemberships TeamMember[]        @relation("TeamMemberCreator")
  clockInRecords     ClockInRecord[]
  uploadedPhotos     Photo[]             @relation("PhotoUploader")
  deletedPhotos      Photo[]             @relation("PhotoDeleter")
  deletedPhotoLogs   PhotoDeletionLog[]  @relation("PhotoDeletionActor")
  originalPhotoLogs  PhotoDeletionLog[]  @relation("PhotoDeletionOriginalAuthor")
  uploadedDocuments  DocumentAttachment[] @relation("DocumentUploader")
  deletedDocuments   DocumentAttachment[] @relation("DocumentDeleter")
  deletedDocumentLogs DocumentDeletionLog[] @relation("DocumentDeletionActor")
  originalDocumentLogs DocumentDeletionLog[] @relation("DocumentDeletionOriginalAuthor")
  reports            Report[]
  reportsValidated   Report[]            @relation("ReportValidator")
  rhExportsCreated   RhExportHistory[]    @relation("RhExportCreator")
  clockInRegularizations ClockInRegularization[] @relation("ClockInRegularizationAuthor")
  refreshTokens      RefreshToken[]
  pushTokens         PushToken[]
  loginAttempts      LoginAttempt[]
  notificationsReceived UserNotificationRecipient[] @relation("UserNotificationRecipientUser")
  notificationsCreated  UserNotification[]          @relation("UserNotificationCreator")
  createdPlanningTaskTemplates PlanningTaskTemplate[]
  createdOfficeLocations       OfficeLocation[]    @relation("OfficeLocationCreator")
  planningAssignments        PlanningAssignment[] @relation("PlanningAssignmentSupervisor")
  createdPlanningAssignments PlanningAssignment[] @relation("PlanningAssignmentCreator")
  taskProgressUpdates        TaskProgressUpdate[]
  assignedFreeMissions       FreeMission[]        @relation("FreeMissionAssignee")
  createdFreeMissions        FreeMission[]        @relation("FreeMissionCreator")
  negotiationAssignments     NegotiationAssignment[] @relation("NegotiationAssignmentAssignee")
  createdNegotiationAssignments NegotiationAssignment[] @relation("NegotiationAssignmentCreator")
  negotiationSessions        NegotiationSession[] @relation("NegotiationSessionUser")
  negotiationVisits          NegotiationVisit[] @relation("NegotiationVisitCreatedBy")
  generalSupervisorSiteScopes GeneralSupervisorSiteScope[] @relation("GeneralSupervisorSiteScopeGeneralSupervisor")
  managedGeneralSupervisorSiteScopes GeneralSupervisorSiteScope[] @relation("GeneralSupervisorSiteScopeProjectManager")
  generalSupervisorProjectScopes GeneralSupervisorProjectScope[] @relation("GeneralSupervisorProjectScopeGeneralSupervisor")
  managedGeneralSupervisorProjectScopes GeneralSupervisorProjectScope[] @relation("GeneralSupervisorProjectScopeProjectManager")
  coordinatorProjectManagerScopes CoordinatorProjectManagerScope[] @relation("CoordinatorProjectManagerScopeCoordinator")
  coordinatedProjectManagerScopes CoordinatorProjectManagerScope[] @relation("CoordinatorProjectManagerScopeProjectManager")
  createdCoordinatorProjectManagerScopes CoordinatorProjectManagerScope[] @relation("CoordinatorProjectManagerScopeCreator")
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  address          String
  city             String
  startDate        DateTime      @db.Date
  endDate          DateTime?     @db.Date
  status           ProjectStatus
  createdAt        DateTime      @default(now())
  projectManagerId String
  createdById      String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdBy        User          @relation("ProjectCreator", fields: [createdById], references: [id])
  sites            Site[]
  freeMissions     FreeMission[]
  negotiationBuildings NegotiationBuilding[]
  negotiationAssignments NegotiationAssignment[]
  negotiationSessions NegotiationSession[]
  negotiationVisits NegotiationVisit[]
  documentAttachments DocumentAttachment[]
  generalSupervisorProjectScopes GeneralSupervisorProjectScope[]

  @@index([projectManagerId])
  @@index([createdById])
}

model Site {
  id             String       @id @default(cuid())
  projectId      String
  name           String
  address        String
  siteType       SiteType     @default(WORKSITE)
  requiresClockIn Boolean     @default(true)
  latitude       Decimal      @db.Decimal(9, 6)
  longitude      Decimal      @db.Decimal(9, 6)
  radiusKm       Decimal      @default(2.0) @db.Decimal(4, 2)
  geofenceType   SiteGeofenceType @default(RADIUS)
  geofencePolygon Json?
  description    String
  status         SiteStatus
  area           Decimal      @db.Decimal(10, 2)
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  siteManagerId  String
  createdById    String
  createdAt      DateTime     @default(now())
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteManager    User         @relation("SiteManager", fields: [siteManagerId], references: [id])
  createdBy      User         @relation("SiteCreator", fields: [createdById], references: [id])
  teams          Team[]
  clockInRecords ClockInRecord[]
  photos         Photo[]
  reports        Report[]
  documentAttachments DocumentAttachment[]
  planningAssignments PlanningAssignment[]
  generalSupervisorScopes GeneralSupervisorSiteScope[]

  @@index([projectId])
  @@index([siteManagerId])
  @@index([createdById])
}

model OfficeLocation {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String?
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  radiusKm    Decimal  @default(0.5) @db.Decimal(4, 2)
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("OfficeLocationCreator", fields: [createdById], references: [id])
  clockInRecords ClockInRecord[]

  @@index([isActive])
  @@index([createdById])
}

model Team {
  id          String     @id @default(cuid())
  name        String
  siteId      String
  teamLeadId  String
  status      TeamStatus
  createdById String
  createdAt   DateTime   @default(now())
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  teamLead    User       @relation("TeamLead", fields: [teamLeadId], references: [id])
  createdBy   User       @relation("TeamCreator", fields: [createdById], references: [id])
  members     TeamMember[]

  @@index([siteId])
  @@index([teamLeadId])
  @@index([createdById])
}

model TeamMember {
  id             String           @id @default(cuid())
  teamId         String
  userId         String
  teamRole       TeamRole
  assignmentDate DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         TeamMemberStatus
  createdById    String
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User             @relation("TeamMemberUser", fields: [userId], references: [id])
  createdBy      User             @relation("TeamMemberCreator", fields: [createdById], references: [id])

  @@index([teamId])
  @@index([userId])
  @@index([createdById])
}

model ClockInRecord {
  id             String         @id @default(cuid())
  siteId         String?
  freeMissionId  String?
  officeLocationId String?
  officeClockInLocation OfficeClockInLocation?
  userId         String
  type           ClockInType
  clockInDate    DateTime       @db.Date
  clockInTime    DateTime       @db.Time(6)
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @db.Decimal(9, 6)
  accuracy       Decimal?       @db.Decimal(6, 2)
  distanceToSite Decimal        @db.Decimal(5, 2)
  status         ClockInStatus
  comment        String?
  timestampLocal DateTime
  isRemoteCheckout Boolean      @default(false)
  isAutoClosed     Boolean      @default(false)
  isRegularized    Boolean      @default(false)
  isLate            Boolean      @default(false)
  createdAt      DateTime       @default(now())
  site           Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  freeMission    FreeMission?   @relation(fields: [freeMissionId], references: [id], onDelete: Cascade)
  officeLocation OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  user           User           @relation(fields: [userId], references: [id])
  report         Report?
  regularizations ClockInRegularization[]

  @@index([siteId])
  @@index([freeMissionId])
  @@index([officeLocationId])
  @@index([officeClockInLocation])
  @@index([userId])
  @@index([userId, siteId, clockInDate])
  @@index([userId, freeMissionId, clockInDate])
  @@index([userId, officeClockInLocation, clockInDate])
  @@index([userId, officeLocationId, clockInDate])
  @@index([isLate])
}

model ClockInRegularization {
  id                     String        @id @default(cuid())
  clockInRecordId        String
  correctedDepartureTime DateTime
  authorId               String
  comment                String
  createdAt              DateTime      @default(now())
  clockInRecord          ClockInRecord @relation(fields: [clockInRecordId], references: [id], onDelete: Cascade)
  author                 User          @relation("ClockInRegularizationAuthor", fields: [authorId], references: [id])

  @@index([clockInRecordId])
  @@index([authorId])
  @@index([createdAt])
}

model Report {
  id                       String                 @id @default(cuid())
  siteId                   String?
  freeMissionId            String?
  site                     Site?                  @relation(fields: [siteId], references: [id])
  freeMission              FreeMission?           @relation(fields: [freeMissionId], references: [id])
  userId                   String
  user                     User                   @relation(fields: [userId], references: [id])
  clockInRecordId          String                 @unique
  clockInRecord            ClockInRecord          @relation(fields: [clockInRecordId], references: [id])
  content                  String
  progression              Int?
  blocage                  String?
  status                   ReportStatus           @default(RECU)
  validationStatus         ReportValidationStatus @default(SUBMITTED)
  validatedForClientAt     DateTime?
  validatedForClientById   String?
  validatedForClientBy     User?                  @relation("ReportValidator", fields: [validatedForClientById], references: [id])
  submittedAt              DateTime               @default(now())
  createdAt                DateTime               @default(now())
  documentAttachments      DocumentAttachment[]

  @@index([siteId])
  @@index([freeMissionId])
  @@index([userId])
  @@index([status])
  @@index([validationStatus])
  @@index([validatedForClientById])
}

model FreeMission {
  id             String            @id @default(cuid())
  projectId      String
  assigneeId     String
  date           DateTime          @db.Date
  action         String
  objectiveText  String?
  status         FreeMissionStatus @default(ASSIGNED)
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User              @relation("FreeMissionAssignee", fields: [assigneeId], references: [id])
  createdBy      User              @relation("FreeMissionCreator", fields: [createdById], references: [id])
  clockInRecords ClockInRecord[]
  photos         Photo[]
  reports        Report[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([date])
  @@index([createdById])
  @@index([deletedAt])
}

model NegotiationBuilding {
  id               String   @id @default(cuid())
  projectId        String
  cluster          String?
  city             String
  commune          String?
  plaque           String?
  habitation       String?
  name             String
  contactInfo      String?
  level            String?
  targetEl         Int?
  actualEl         Int?
  longitude        Decimal? @db.Decimal(10, 7)
  latitude         Decimal? @db.Decimal(10, 7)
  layer            String?
  color            String?
  operatorPresence String?
  negotiationStatus String?
  remark           String?
  sourceImportName String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visits           NegotiationVisit[]

  @@index([projectId])
  @@index([city])
  @@index([commune])
  @@index([negotiationStatus])
}

model NegotiationAssignment {
  id          String                      @id @default(cuid())
  projectId   String
  assigneeId  String
  date        DateTime                    @db.Date
  plannedZone String?
  instruction String?
  status      NegotiationAssignmentStatus @default(PLANNED)
  createdById String
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  deletedAt   DateTime?
  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User                        @relation("NegotiationAssignmentAssignee", fields: [assigneeId], references: [id])
  createdBy   User                        @relation("NegotiationAssignmentCreator", fields: [createdById], references: [id])
  sessions    NegotiationSession[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([date])
  @@index([createdById])
  @@index([deletedAt])
}

model NegotiationSession {
  id              String                   @id @default(cuid())
  assignmentId    String?
  projectId       String
  userId          String
  date            DateTime                 @db.Date
  startTime       DateTime
  startLatitude   Decimal                  @db.Decimal(10, 7)
  startLongitude  Decimal                  @db.Decimal(10, 7)
  startAccuracy   Decimal?                 @db.Decimal(7, 2)
  endTime         DateTime?
  endLatitude     Decimal?                 @db.Decimal(10, 7)
  endLongitude    Decimal?                 @db.Decimal(10, 7)
  endAccuracy     Decimal?                 @db.Decimal(7, 2)
  comment         String?
  status          NegotiationSessionStatus @default(OPEN)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  assignment      NegotiationAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User                     @relation("NegotiationSessionUser", fields: [userId], references: [id])
  visits          NegotiationVisit[]

  @@index([assignmentId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model NegotiationVisit {
  id              String                 @id @default(cuid())
  sessionId       String
  buildingId      String?
  projectId       String
  visitedAt       DateTime               @default(now())
  buildingName    String
  city            String?
  commune         String?
  contactInfo     String?
  latitude        Decimal?               @db.Decimal(10, 7)
  longitude       Decimal?               @db.Decimal(10, 7)
  accuracy        Decimal?               @db.Decimal(7, 2)
  status          NegotiationVisitStatus
  remark          String
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  session         NegotiationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  building        NegotiationBuilding?   @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("NegotiationVisitCreatedBy", fields: [createdById], references: [id])
  photos          Photo[]

  @@index([sessionId])
  @@index([buildingId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([visitedAt])
}

model PlanningAssignment {
  id             String                   @id @default(cuid())
  date           DateTime                 @db.Date
  supervisorId   String
  siteId         String
  action         String
  targetProgress Int?
  targetQuantity Decimal?                 @db.Decimal(12, 2)
  targetUnit     String?
  objectiveText  String?
  plannedDurationMinutes Int?
  status         PlanningAssignmentStatus @default(ASSIGNED)
  workLocationType PlanningWorkLocationType @default(ON_SITE)
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  supervisor     User                     @relation("PlanningAssignmentSupervisor", fields: [supervisorId], references: [id])
  site           Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy      User                     @relation("PlanningAssignmentCreator", fields: [createdById], references: [id])
  photos         Photo[]
  progressUpdates TaskProgressUpdate[]

  @@index([date])
  @@index([siteId])
  @@index([supervisorId])
  @@index([supervisorId, date, siteId])
  @@index([createdById])
  @@index([deletedAt])
}

model GeneralSupervisorSiteScope {
  id                  String                           @id @default(cuid())
  generalSupervisorId String
  projectManagerId    String
  siteId              String
  startDate           DateTime                         @db.Date
  endDate             DateTime?                        @db.Date
  status              GeneralSupervisorSiteScopeStatus @default(ACTIVE)
  createdAt           DateTime                         @default(now())
  generalSupervisor   User                             @relation("GeneralSupervisorSiteScopeGeneralSupervisor", fields: [generalSupervisorId], references: [id])
  projectManager      User                             @relation("GeneralSupervisorSiteScopeProjectManager", fields: [projectManagerId], references: [id])
  site                Site                             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([generalSupervisorId, status])
  @@index([projectManagerId, status])
  @@index([siteId, status])
  @@index([startDate])
  @@index([endDate])
}

model PlanningTaskTemplate {
  id             String                   @id @default(cuid())
  name           String
  action         String
  targetProgress Int?
  targetQuantity Decimal?                 @db.Decimal(12, 2)
  targetUnit     String?
  objectiveText  String?
  plannedDurationMinutes Int?
  workLocationType PlanningWorkLocationType @default(ON_SITE)
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdBy      User                     @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([workLocationType])
}

model UserNotification {
  id             String                   @id @default(cuid())
  title          String
  message        String
  audience       UserNotificationAudience
  targetRole     Role?
  createdById    String
  createdAt      DateTime                 @default(now())
  createdBy      User                     @relation("UserNotificationCreator", fields: [createdById], references: [id])
  recipients     UserNotificationRecipient[]

  @@index([createdById])
  @@index([targetRole])
  @@index([createdAt])
}

model UserNotificationRecipient {
  id             String           @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  notification   UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User             @relation("UserNotificationRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([notificationId])
}

model GeneralSupervisorProjectScope {
  id                  String                           @id @default(cuid())
  generalSupervisorId String
  projectManagerId    String
  projectId           String
  startDate           DateTime                         @db.Date
  endDate             DateTime?                        @db.Date
  status              GeneralSupervisorSiteScopeStatus @default(ACTIVE)
  createdAt           DateTime                         @default(now())
  generalSupervisor   User                             @relation("GeneralSupervisorProjectScopeGeneralSupervisor", fields: [generalSupervisorId], references: [id])
  projectManager      User                             @relation("GeneralSupervisorProjectScopeProjectManager", fields: [projectManagerId], references: [id])
  project             Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([generalSupervisorId, projectId, startDate])
  @@index([generalSupervisorId, status])
  @@index([projectManagerId, status])
  @@index([projectId, status])
  @@index([startDate])
  @@index([endDate])
}

model Photo {
  id          String             @id @default(cuid())
  siteId      String?
  freeMissionId String?
  negotiationVisitId String?
  uploadedById String
  planningAssignmentId String?
  category    PhotoCategory
  tags        PhotoTag[]         @default([])
  description String
  filename    String
  storageKey  String             @unique
  url         String
  fileSize    Int
  format      String
  latitude    Decimal?           @db.Decimal(9, 6)
  longitude   Decimal?           @db.Decimal(9, 6)
  timestampLocal DateTime        @default(now())
  takenAt     DateTime
  isDeleted   Boolean            @default(false)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime           @default(now())
  site        Site?              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  freeMission FreeMission?       @relation(fields: [freeMissionId], references: [id], onDelete: Cascade)
  negotiationVisit NegotiationVisit? @relation(fields: [negotiationVisitId], references: [id], onDelete: Cascade)
  uploadedBy  User               @relation("PhotoUploader", fields: [uploadedById], references: [id])
  planningAssignment PlanningAssignment? @relation(fields: [planningAssignmentId], references: [id], onDelete: SetNull)
  deletedBy   User?              @relation("PhotoDeleter", fields: [deletedById], references: [id])
  deletionLogs PhotoDeletionLog[]

  @@index([siteId])
  @@index([freeMissionId])
  @@index([negotiationVisitId])
  @@index([uploadedById])
  @@index([planningAssignmentId])
  @@index([deletedById])
  @@index([siteId, isDeleted])
}

model PhotoDeletionLog {
  id               String   @id @default(cuid())
  photoId          String
  deletedById      String
  originalAuthorId String
  reason           String
  deletedAt        DateTime @default(now())
  photo            Photo    @relation(fields: [photoId], references: [id])
  deletedBy        User     @relation("PhotoDeletionActor", fields: [deletedById], references: [id])
  originalAuthor   User     @relation("PhotoDeletionOriginalAuthor", fields: [originalAuthorId], references: [id])

  @@index([photoId])
  @@index([deletedById])
  @@index([originalAuthorId])
}

model CoordinatorProjectManagerScope {
  id               String   @id @default(cuid())
  coordinatorId    String
  projectManagerId String
  createdById      String
  createdAt        DateTime @default(now())
  coordinator      User     @relation("CoordinatorProjectManagerScopeCoordinator", fields: [coordinatorId], references: [id], onDelete: Cascade)
  projectManager   User     @relation("CoordinatorProjectManagerScopeProjectManager", fields: [projectManagerId], references: [id], onDelete: Cascade)
  createdBy        User     @relation("CoordinatorProjectManagerScopeCreator", fields: [createdById], references: [id])

  @@unique([coordinatorId, projectManagerId])
  @@index([coordinatorId])
  @@index([projectManagerId])
  @@index([createdById])
}

model TaskProgressUpdate {
  id           String             @id @default(cuid())
  assignmentId String
  progress     Int?
  actualQuantity Decimal?           @db.Decimal(12, 2)
  comment      String?
  blocked      Boolean            @default(false)
  completed    Boolean            @default(false)
  createdById  String
  createdAt    DateTime           @default(now())
  assignment   PlanningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdBy    User               @relation(fields: [createdById], references: [id])

  @@index([assignmentId])
  @@index([createdById])
  @@index([createdAt])
}

model DocumentAttachment {
  id          String   @id @default(cuid())
  projectId   String?
  siteId      String?
  reportId    String?
  uploadedById String
  filename    String
  storageKey  String   @unique
  url         String
  fileSize    Int
  contentType String
  extension   String
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  report      Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  deletedBy   User?    @relation("DocumentDeleter", fields: [deletedById], references: [id])
  deletionLogs DocumentDeletionLog[]

  @@index([projectId])
  @@index([siteId])
  @@index([reportId])
  @@index([uploadedById])
  @@index([deletedById])
  @@index([isDeleted])
}

model DocumentDeletionLog {
  id               String   @id @default(cuid())
  documentId       String
  deletedById      String
  originalAuthorId String
  reason           String
  deletedAt        DateTime @default(now())
  document         DocumentAttachment @relation(fields: [documentId], references: [id])
  deletedBy        User     @relation("DocumentDeletionActor", fields: [deletedById], references: [id])
  originalAuthor   User     @relation("DocumentDeletionOriginalAuthor", fields: [originalAuthorId], references: [id])

  @@index([documentId])
  @@index([deletedById])
  @@index([originalAuthorId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceLabel String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  userId     String?
  emailOrKey String
  ipAddress  String
  attemptedAt DateTime @default(now())
  success    Boolean
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([emailOrKey, ipAddress, attemptedAt])
}

model RhExportHistory {
  id          String         @id @default(cuid())
  createdById String
  format      RhExportFormat
  from        DateTime
  to          DateTime
  userId      String?
  projectId   String?
  rowCount    Int
  storageKey  String?
  fileName    String?
  contentType String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  createdBy   User           @relation("RhExportCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@index([createdAt])
}
